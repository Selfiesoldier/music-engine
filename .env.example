# Server Networking
PORT=30060
HOST=0.0.0.0

# Authentication & Security
ADMIN_PASSWORD=admin
SESSION_SECRET=musicbot_engine_secure_secret_key_30060

# Audio Streaming Configuration
AUDIO_BITRATE=192k
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2
INITIAL_BURST_CHUNKS=80
MAX_BURST_BUFFER_CHUNKS=200

# Cache Configuration
CACHE_DIR=cache
MAX_CACHE_SIZE_MB=1024
MAX_TRACK_DURATION_SEC=900

# YouTube / Cookies
COOKIES_FILE=cookies.master.txt

# API Protection Token (required for bot commands / control API)
API_SECRET=highrise_music_secret_2026

# =============================================
# Residential Audio Bridge Configuration
# =============================================
# Name shown in logs when this bridge registers with client bot servers
BRIDGE_NAME=Home PC

# Comma-separated list of all music server URLs this bridge will register with
# Single server example:   BOT_SERVER_URLS=http://92.118.206.166:30139
# Multi-server example:    BOT_SERVER_URLS=http://server1:30139,http://server2:30139,http://server3:30139
BOT_SERVER_URLS=http://92.118.206.166:30139

# Max concurrent yt-dlp downloads (keep at 1 for Termux/phone to stay below 50% CPU)
MAX_CONCURRENT_DOWNLOADS=1

# =============================================
# Download Worker Configuration (Termux / VPS)
# =============================================
# URL of the dedicated download worker (set on the music server side)
DOWNLOAD_WORKER_URL=

# Worker cache limits
MAX_CACHE_TRACKS=100
MAX_CACHE_MB=400
